<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="regain_wheelchair">

    <!-- ===================== BODY ===================== -->
    <link name="base_link">
      <inertial>
        <pose>0.08 0 0.35 0 0 0</pose>
        <mass>40</mass>
        <inertia>
          <ixx>3.0</ixx>
          <iyy>4.3</iyy>
          <izz>3.0</izz>
        </inertia>
      </inertial>

      <!-- Lower frame / battery housing -->
      <visual name="frame_visual">
        <pose>0.05 0 0.22 0 0 0</pose>
        <geometry><box><size>0.60 0.40 0.14</size></box></geometry>
        <material>
          <ambient>0.15 0.15 0.18 1</ambient>
          <diffuse>0.15 0.15 0.18 1</diffuse>
        </material>
      </visual>
      <collision name="frame_collision">
        <pose>0.05 0 0.22 0 0 0</pose>
        <geometry><box><size>0.60 0.40 0.14</size></box></geometry>
      </collision>

      <!-- Seat -->
      <visual name="seat_visual">
        <pose>0.05 0 0.33 0 0 0</pose>
        <geometry><box><size>0.46 0.46 0.08</size></box></geometry>
        <material>
          <ambient>0.05 0.15 0.45 1</ambient>
          <diffuse>0.05 0.15 0.45 1</diffuse>
        </material>
      </visual>
      <collision name="seat_collision">
        <pose>0.05 0 0.33 0 0 0</pose>
        <geometry><box><size>0.46 0.46 0.08</size></box></geometry>
      </collision>

      <!-- Backrest -->
      <visual name="backrest_visual">
        <pose>-0.14 0 0.63 0 0 0</pose>
        <geometry><box><size>0.08 0.46 0.52</size></box></geometry>
        <material>
          <ambient>0.05 0.15 0.45 1</ambient>
          <diffuse>0.05 0.15 0.45 1</diffuse>
        </material>
      </visual>
      <collision name="backrest_collision">
        <pose>-0.14 0 0.63 0 0 0</pose>
        <geometry><box><size>0.08 0.46 0.52</size></box></geometry>
      </collision>

      <!-- Left armrest (pad + post) -->
      <visual name="left_armrest_pad_visual">
        <pose>0.05 0.26 0.58 0 0 0</pose>
        <geometry><box><size>0.34 0.06 0.04</size></box></geometry>
        <material>
          <ambient>0.08 0.08 0.08 1</ambient>
          <diffuse>0.08 0.08 0.08 1</diffuse>
        </material>
      </visual>
      <collision name="left_armrest_collision">
        <pose>0.05 0.26 0.58 0 0 0</pose>
        <geometry><box><size>0.34 0.06 0.04</size></box></geometry>
      </collision>
      <visual name="left_armrest_post_visual">
        <pose>-0.05 0.26 0.465 0 0 0</pose>
        <geometry><box><size>0.04 0.04 0.19</size></box></geometry>
        <material>
          <ambient>0.15 0.15 0.18 1</ambient>
          <diffuse>0.15 0.15 0.18 1</diffuse>
        </material>
      </visual>

      <!-- Right armrest (pad + post) -->
      <visual name="right_armrest_pad_visual">
        <pose>0.05 -0.26 0.58 0 0 0</pose>
        <geometry><box><size>0.34 0.06 0.04</size></box></geometry>
        <material>
          <ambient>0.08 0.08 0.08 1</ambient>
          <diffuse>0.08 0.08 0.08 1</diffuse>
        </material>
      </visual>
      <collision name="right_armrest_collision">
        <pose>0.05 -0.26 0.58 0 0 0</pose>
        <geometry><box><size>0.34 0.06 0.04</size></box></geometry>
      </collision>
      <visual name="right_armrest_post_visual">
        <pose>-0.05 -0.26 0.465 0 0 0</pose>
        <geometry><box><size>0.04 0.04 0.19</size></box></geometry>
        <material>
          <ambient>0.15 0.15 0.18 1</ambient>
          <diffuse>0.15 0.15 0.18 1</diffuse>
        </material>
      </visual>

      <!-- Joystick control panel (on the right armrest, front end) -->
      <visual name="control_box_visual">
        <pose>0.24 -0.26 0.575 0 0 0</pose>
        <geometry><box><size>0.10 0.08 0.05</size></box></geometry>
        <material>
          <ambient>0.02 0.02 0.02 1</ambient>
          <diffuse>0.02 0.02 0.02 1</diffuse>
        </material>
      </visual>
      <visual name="joystick_stalk_visual">
        <pose>0.24 -0.26 0.63 0 0 0</pose>
        <geometry><cylinder><radius>0.008</radius><length>0.06</length></cylinder></geometry>
        <material>
          <ambient>0.6 0.6 0.6 1</ambient>
          <diffuse>0.6 0.6 0.6 1</diffuse>
        </material>
      </visual>
      <visual name="joystick_knob_visual">
        <pose>0.24 -0.26 0.675 0 0 0</pose>
        <geometry><sphere><radius>0.018</radius></sphere></geometry>
        <material>
          <ambient>0.8 0.1 0.1 1</ambient>
          <diffuse>0.8 0.1 0.1 1</diffuse>
        </material>
      </visual>

      <!-- Footrest: hanger bar + footplate -->
      <visual name="footrest_hanger_visual">
        <pose>0.37 0 0.27 0 0 0</pose>
        <geometry><box><size>0.04 0.30 0.20</size></box></geometry>
        <material>
          <ambient>0.15 0.15 0.18 1</ambient>
          <diffuse>0.15 0.15 0.18 1</diffuse>
        </material>
      </visual>
      <visual name="footplate_visual">
        <pose>0.49 0 0.17 0 0 0</pose>
        <geometry><box><size>0.22 0.34 0.02</size></box></geometry>
        <material>
          <ambient>0.08 0.08 0.08 1</ambient>
          <diffuse>0.08 0.08 0.08 1</diffuse>
        </material>
      </visual>
      <collision name="footplate_collision">
        <pose>0.49 0 0.17 0 0 0</pose>
        <geometry><box><size>0.22 0.34 0.02</size></box></geometry>
      </collision>

      <!-- Front casters: frictionless spheres (act as swivel casters) -->
      <visual name="left_caster_visual">
        <pose>0.28 0.20 0.07 0 0 0</pose>
        <geometry><sphere><radius>0.07</radius></sphere></geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
        </material>
      </visual>
      <collision name="left_caster_collision">
        <pose>0.28 0.20 0.07 0 0 0</pose>
        <geometry><sphere><radius>0.07</radius></sphere></geometry>
        <surface>
          <friction><ode><mu>0</mu><mu2>0</mu2></ode></friction>
        </surface>
      </collision>
      <visual name="right_caster_visual">
        <pose>0.28 -0.20 0.07 0 0 0</pose>
        <geometry><sphere><radius>0.07</radius></sphere></geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
        </material>
      </visual>
      <collision name="right_caster_collision">
        <pose>0.28 -0.20 0.07 0 0 0</pose>
        <geometry><sphere><radius>0.07</radius></sphere></geometry>
        <surface>
          <friction><ode><mu>0</mu><mu2>0</mu2></ode></friction>
        </surface>
      </collision>
    </link>

    <!-- ===================== DRIVE WHEELS ===================== -->
    <link name="left_wheel">
      <pose>0 0.29 0.17 -1.5707 0 0</pose>
      <inertial>
        <mass>3</mass>
        <inertia>
          <ixx>0.0226</ixx>
          <iyy>0.0226</iyy>
          <izz>0.0434</izz>
        </inertia>
      </inertial>
      <visual name="tire_visual">
        <geometry><cylinder><radius>0.17</radius><length>0.06</length></cylinder></geometry>
        <material>
          <ambient>0.03 0.03 0.03 1</ambient>
          <diffuse>0.03 0.03 0.03 1</diffuse>
        </material>
      </visual>
      <visual name="hub_marker_visual">
        <pose>0.10 0 0 0 0 0</pose>
        <geometry><box><size>0.06 0.03 0.062</size></box></geometry>
        <material>
          <ambient>0.8 0.8 0.8 1</ambient>
          <diffuse>0.8 0.8 0.8 1</diffuse>
        </material>
      </visual>
      <collision name="tire_collision">
        <geometry><cylinder><radius>0.17</radius><length>0.06</length></cylinder></geometry>
        <surface>
          <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
        </surface>
      </collision>
    </link>

    <link name="right_wheel">
      <pose>0 -0.29 0.17 -1.5707 0 0</pose>
      <inertial>
        <mass>3</mass>
        <inertia>
          <ixx>0.0226</ixx>
          <iyy>0.0226</iyy>
          <izz>0.0434</izz>
        </inertia>
      </inertial>
      <visual name="tire_visual">
        <geometry><cylinder><radius>0.17</radius><length>0.06</length></cylinder></geometry>
        <material>
          <ambient>0.03 0.03 0.03 1</ambient>
          <diffuse>0.03 0.03 0.03 1</diffuse>
        </material>
      </visual>
      <visual name="hub_marker_visual">
        <pose>0.10 0 0 0 0 0</pose>
        <geometry><box><size>0.06 0.03 0.062</size></box></geometry>
        <material>
          <ambient>0.8 0.8 0.8 1</ambient>
          <diffuse>0.8 0.8 0.8 1</diffuse>
        </material>
      </visual>
      <collision name="tire_collision">
        <geometry><cylinder><radius>0.17</radius><length>0.06</length></cylinder></geometry>
        <surface>
          <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
        </surface>
      </collision>
    </link>

    <!-- ===================== JOINTS ===================== -->
    <joint name="left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>left_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
      </axis>
    </joint>

    <joint name="right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>right_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
      </axis>
    </joint>

    <!-- ===================== DRIVE PLUGIN ===================== -->
    <plugin filename="gz-sim-diff-drive-system"
            name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.58</wheel_separation>
      <wheel_radius>0.17</wheel_radius>
      <max_linear_velocity>1.0</max_linear_velocity>
      <max_angular_velocity>1.5</max_angular_velocity>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <max_angular_acceleration>2.0</max_angular_acceleration>
      <topic>/regain/cmd_vel</topic>
      <odom_topic>/regain/odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
    </plugin>

  </model>
</sdf>