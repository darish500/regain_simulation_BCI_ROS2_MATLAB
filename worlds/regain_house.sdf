        <visual name="c4_seat_v"><pose>7.8 2.95 0.45 0 0 0</pose><geometry><box><size>0.4 0.4 0.04</size></box></geometry><material><ambient>0.45 0.30 0.18 1</ambient><diffuse>0.45 0.30 0.18 1</diffuse></material></visual>
        <visual name="c4_base_v"><pose>7.8 2.95 0.215 0 0 0</pose><geometry><box><size>0.3 0.3 0.43</size></box></geometry><material><ambient>0.30 0.20 0.12 1</ambient><diffuse>0.30 0.20 0.12 1</diffuse></material></visual>
