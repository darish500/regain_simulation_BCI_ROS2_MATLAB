        <visual name="wardrobe_v"><pose>6.2 7.6 1.0 0 0 0</pose><geometry><box><size>1.4 0.6 2.0</size></box></geometry><material><ambient>0.60 0.50 0.40 1</ambient><diffuse>0.60 0.50 0.40 1</diffuse></material></visual>
