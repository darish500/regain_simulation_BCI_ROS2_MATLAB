        <!-- Bedside table -->
        <visual name="bedside_v"><pose>9.65 5.75 0.25 0 0 0</pose><geometry><box><size>0.4 0.4 0.5</size></box></geometry><material><ambient>0.45 0.30 0.18 1</ambient><diffuse>0.45 0.30 0.18 1</diffuse></material></visual>
