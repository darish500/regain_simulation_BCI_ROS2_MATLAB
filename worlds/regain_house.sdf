        <visual name="mattress_v"><pose>8.75 6.8 0.4 0 0 0</pose><geometry><box><size>1.9 1.4 0.2</size></box></geometry><material><ambient>0.85 0.88 0.95 1</ambient><diffuse>0.85 0.88 0.95 1</diffuse></material></visual>
