        <visual name="c1_seat_v"><pose>7.2 4.5 0.45 0 0 0</pose><geometry><box><size>0.4 0.4 0.04</size></box></geometry><material><ambient>0.45 0.30 0.18 1</ambient><diffuse>0.45 0.30 0.18 1</diffuse></material></visual>
        <visual name="c1_base_v"><pose>7.2 4.5 0.215 0 0 0</pose><geometry><box><size>0.3 0.3 0.43</size></box></geometry><material><ambient>0.30 0.20 0.12 1</ambient><diffuse>0.30 0.20 0.12 1</diffuse></material></visual>
        <visual name="c1_back_v"><pose>7.2 4.68 0.67 0 0 0</pose><geometry><box><size>0.4 0.04 0.4</size></box></geometry><material><ambient>0.45 0.30 0.18 1</ambient><diffuse>0.45 0.30 0.18 1</diffuse></material></visual>
        <collision name="c1_c"><pose>7.2 4.5 0.235 0 0 0</pose><geometry><box><size>0.4 0.4 0.47</size></box></geometry></collision>

        <!-- Chair 2 (north side, x=7.8) -->
        <visual name="c2_seat_v"><pose>7.8 4.5 0.45 0 0 0</pose><geometry><box><size>0.4 0.4 0.04</size></box></geometry><material><ambient>0.45 0.30 0.18 1</ambient><diffuse>0.45 0.30 0.18 1</diffuse></material></visual>
        <visual name="c2_base_v"><pose>7.8 4.5 0.215 0 0 0</pose><geometry><box><size>0.3 0.3 0.43</size></box></geometry><material><ambient>0.30 0.20 0.12 1</ambient><diffuse>0.30 0.20 0.12 1</diffuse></material></visual>
        <visual name="c2_back_v"><pose>7.8 4.68 0.67 0 0 0</pose><geometry><box><size>0.4 0.04 0.4</size></box></geometry><material><ambient>0.45 0.30 0.18 1</ambient><diffuse>0.45 0.30 0.18 1</diffuse></material></visual>
        <collision name="c2_c"><pose>7.8 4.5 0.235 0 0 0</pose><geometry><box><size>0.4 0.4 0.47</size></box></geometry></collision>

        <!-- Chair 3 (south side, x=7.2) -->
        <visual name="c3_seat_v"><pose>7.2 2.95 0.45 0 0 0</pose><geometry><box><size>0.4 0.4 0.04</size></box></geometry><material><ambient>0.45 0.30 0.18 1</ambient><diffuse>0.45 0.30 0.18 1</diffuse></material></visual>
        <visual name="c3_base_v"><pose>7.2 2.95 0.215 0 0 0</pose><geometry><box><size>0.3 0.3 0.43</size></box></geometry><material><ambient>0.30 0.20 0.12 1</ambient><diffuse>0.30 0.20 0.12 1</diffuse></material></visual>
